{
  "$comment": "The terva-sh design foundation. Every app shares the foundation and adds its own accent. `just generate` renders dist/<app>.css from this file. Commit both.",
  "brand": {
    "$comment": "The brand pigments, for brand marks and the terva landing page. A component reads the --ui-* roles, not these.",
    "tar": "#11100E",
    "deep-tar": "#0A0A09",
    "charcoal": "#1B1D1E",
    "slate": "#2E343B",
    "birch": "#F5F1E8",
    "amber": "#D9902F",
    "hot": "#F2B84B",
    "orange": "#F29100",
    "cursor": "#FDB515",
    "pine": "#1F4D3A",
    "mint": "#6EE7B7"
  },
  "foundation": {
    "$comment": "The roles every app shares. Birch is the light scheme and Tar the dark one. Each scheme declares the same roles. Every text role meets 4.5:1 on bg, surface and raised.",
    "schemes": {
      "light": {
        "bg": "#FBF8F2",
        "surface": "#F2EDE2",
        "raised": "#FFFFFF",
        "line": "#DED6C5",
        "line-strong": "#C9BFA9",
        "heading": "#0F0E0C",
        "fg": "#1C1A16",
        "muted": "#6B6355",
        "user": "#DCE5E1",
        "user-fg": "#1C1A16",
        "ok": "#2A7338",
        "warn": "#8F5F0C",
        "danger": "#B83A2E",
        "hover": "rgba(28, 26, 22, 0.07)",
        "shadow": "rgba(60, 45, 20, 0.16)"
      },
      "dark": {
        "bg": "#0A0A09",
        "surface": "#151412",
        "raised": "#1E1C18",
        "line": "#2C2A25",
        "line-strong": "#3C3830",
        "heading": "#F5F1E8",
        "fg": "#DCD6C9",
        "muted": "#9A9384",
        "user": "#2C3A3F",
        "user-fg": "#ECE7DD",
        "ok": "#7FBF8A",
        "warn": "#D6A86A",
        "danger": "#D67A6A",
        "hover": "rgba(220, 214, 201, 0.07)",
        "shadow": "rgba(0, 0, 0, 0.45)"
      }
    },
    "scale": {
      "$comment": "Shape, type and space. These do not change with the scheme.",
      "font-sans": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "font-mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
      "fs-note": "11px",
      "fs-detail": "12px",
      "fs-ui": "13px",
      "fs-body": "15px",
      "radius-inline": "3px",
      "radius-control": "6px",
      "radius": "8px",
      "radius-sheet": "12px",
      "radius-pill": "999px",
      "space-1": "4px",
      "space-2": "8px",
      "space-3": "12px",
      "space-4": "16px",
      "space-5": "24px",
      "space-6": "32px",
      "space-7": "48px",
      "space-8": "80px"
    }
  },
  "accents": {
    "$comment": "One accent per app, with three roles in each scheme. accent-hot is the hover state, and it moves away from the ground: lighter on dark, darker on light. on-accent is text drawn on an accent fill.",
    "terva": {
      "light": { "accent": "#A5571A", "accent-hot": "#8A4614", "on-accent": "#FBF8F2" },
      "dark": { "accent": "#D9902F", "accent-hot": "#F2B84B", "on-accent": "#11100E" }
    },
    "lampi": {
      "light": { "accent": "#27509B", "accent-hot": "#1C3D78", "on-accent": "#FBF8F2" },
      "dark": { "accent": "#9DB8F0", "accent-hot": "#BFD0F5", "on-accent": "#101A30" }
    },
    "ketju": {
      "light": { "accent": "#2F5FB3", "accent-hot": "#244C91", "on-accent": "#FFFFFF" },
      "dark": { "accent": "#7FA3E8", "accent-hot": "#A3BEF0", "on-accent": "#0F1622" }
    },
    "git-ticket-canvas": {
      "light": { "accent": "#2A63C0", "accent-hot": "#1F4E99", "on-accent": "#FFFFFF" },
      "dark": { "accent": "#6AA3F0", "accent-hot": "#94BDF5", "on-accent": "#0E1520" }
    }
  }
}
